#!/bin/bash
#
#  macupdate – automatische nächtliche Updates für deinen Mac
#  ─────────────────────────────────────────────────────────────────────────
#  Ein Lauf arbeitet diese Schritte nacheinander ab:
#    1. Apps aus GitHub-Releases (PhotoCraft, PdfCraft, WordCraft, DeckCraft, GridCraft)
#    2. Homebrew (Formeln und Casks)
#    3. App Store (über das Kommandozeilen-Tool "mas")
#    4. macOS-Systemupdates (softwareupdate)
#
#  Einrichten (einmalig im Terminal):   bash macupdate --install
#  Danach:                              macupdate --help
#
#  Hinweis: Das Script läuft mit dem macOS-eigenen /bin/bash 3.2.
#  Bitte keine Bash-4-Features einbauen (assoziative Arrays, mapfile, ${x,,} …).
#

MACUPDATE_VERSION="1.1.0"

# ── Pfade ─────────────────────────────────────────────────────────────────────
# MACUPDATE_TEST_ROOT ist nur für automatische Tests gedacht und sonst leer.
_R="${MACUPDATE_TEST_ROOT:-}"

INSTALL_BIN="$_R/usr/local/bin/macupdate"
HELPER_DIR="$_R/Library/PrivilegedHelperTools"
HELPER="$HELPER_DIR/local.macupdate.helper"
HELPER_MAS="$HELPER_DIR/local.macupdate.mas"
HELPER_CRED="$HELPER_DIR/local.macupdate.cred"
SUDOERS_FILE="$_R/etc/sudoers.d/macupdate"
APP_DIRS=("$_R/Applications" "$HOME/Applications")

AGENT_LABEL="local.macupdate.nightly"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"
CONFIG_DIR="$HOME/.config/macupdate"
SETTINGS_FILE="$CONFIG_DIR/settings.conf"
STATE_DIR="$HOME/Library/Application Support/macupdate"
LOG_DIR="$HOME/Library/Logs/macupdate"
SKIP_FILE="$STATE_DIR/skip-next"
LOCK_DIR="$STATE_DIR/lock"
LAST_RUN_FILE="$STATE_DIR/last-run"
WAKE_STATE_FILE="$STATE_DIR/wake-applied"
BACKUP_DIR="$STATE_DIR/backup"
STAGE_DIR="$STATE_DIR/staging"

# launchd startet Jobs mit sehr kargem PATH – Homebrew-Pfade ergänzen.
# Systemwerkzeuge stehen bewusst vorne, damit z. B. GNU-Tools nichts verändern.
PATH="${MACUPDATE_TEST_PATH:+$MACUPDATE_TEST_PATH:}/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin"
export PATH
USER="${USER:-$(id -un)}"
export USER

# ── Laufzeit-Zustand ──────────────────────────────────────────────────────────
RUN_MODE=""          # scheduled | manual | check
INTERACTIVE=0        # 1 = jemand sitzt am Terminal und kann Fragen beantworten
LOG_FILE=""
ERRORS=0
WARNINGS=0
CHECK_FOUND=0
MACOS_PENDING=0      # 1 = macOS-Update mit Neustart wird ganz am Ende installiert
MACOS_SCOPE="minor"
SUM_GITHUB=""; SUM_BREW=""; SUM_MAS=""; SUM_MACOS=""
CHANGES=()
GH_MNT=""
GH_WORK=""
SUDO_KEEPALIVE_PID=""

# ══════════════════════════════════════════════════════════════════════════════
#  Gemeinsame Funktionen – werden zusätzlich wortgleich in den Root-Helper
#  geschrieben (siehe build_helper).
# ══════════════════════════════════════════════════════════════════════════════
IFS= read -r -d '' SHARED_FUNCS <<'EOF_SHARED'
# ── Gemeinsame Funktionen (stehen auch im Hauptscript) ──────────────────────

is_uint() { case $1 in ''|*[!0-9]*) return 1 ;; esac; return 0; }

is_arm() { [[ $(sysctl -n hw.optional.arm64 2>/dev/null) == 1 ]]; }

# Befehl mit Zeitlimit ausführen:  run_with_timeout SEKUNDEN befehl [argumente …]
run_with_timeout() {
  local secs=$1 pid watcher rc
  shift
  "$@" <&0 &
  pid=$!
  (
    trap 'kill "$sp" 2>/dev/null; exit 0' TERM
    sleep "$secs" &
    sp=$!
    wait "$sp"
    kill -TERM "$pid" 2>/dev/null
    sleep 10 &
    sp=$!
    wait "$sp"
    kill -KILL "$pid" 2>/dev/null
  ) >/dev/null 2>&1 &
  watcher=$!
  wait "$pid"
  rc=$?
  kill -TERM "$watcher" 2>/dev/null
  wait "$watcher" 2>/dev/null
  return $rc
}

# Ausgabe von "softwareupdate --list" (über stdin) zerlegen.
# $1 = installierte macOS-Hauptversion (z. B. 26)
# Ausgabe: pro Update eine Zeile  neustart|grosses_upgrade|label|titel|version
su_parse_list() {
  local cur=$1 line label="" title="" version="" restart=0 major=0 vmaj
  while IFS= read -r line || [[ -n $line ]]; do
    case $line in
      *"Label: "*)
        if [[ -n $label ]]; then
          printf '%s|%s|%s|%s|%s\n' "$restart" "$major" "$label" "$title" "$version"
        fi
        label=${line#*Label: }
        label=${label%"${label##*[![:space:]]}"}
        title=""; version=""; restart=0; major=0
        ;;
      *"Title: "*)
        [[ -n $label ]] || continue
        title=${line#*Title: }
        title=${title%%, Version:*}
        version=""
        case $line in
          *"Version: "*) version=${line#*Version: }; version=${version%%,*} ;;
        esac
        case $line in
          *"Action: restart"*|*"Action: shut down"*) restart=1 ;;
        esac
        case $title in
          macOS*)
            vmaj=${version%%.*}
            if is_uint "$vmaj" && is_uint "$cur" && (( vmaj > cur )); then major=1; fi
            ;;
        esac
        ;;
    esac
  done
  if [[ -n $label ]]; then
    printf '%s|%s|%s|%s|%s\n' "$restart" "$major" "$label" "$title" "$version"
  fi
}

# macOS-Updates installieren – wird nur im Root-Helper aufgerufen.
# $1 = minor|all (große Upgrades mitnehmen?)   $2 = norestart|restart|download
macos_install() {
  local scope=$1 mode=$2 cur items r m label title version agree=0
  local -a labels extra
  labels=()
  extra=()
  cur=$(sw_vers -productVersion 2>/dev/null)
  cur=${cur%%.*}
  items=$(softwareupdate --list 2>&1 | su_parse_list "$cur")
  while IFS='|' read -r r m label title version; do
    [[ -n $label ]] || continue
    if [[ $m == 1 && $scope != all ]]; then continue; fi
    if [[ $mode == norestart ]]; then
      [[ $r == 0 ]] || continue
    else
      [[ $r == 1 ]] || continue
    fi
    labels+=("$label")
    if [[ $m == 1 ]]; then agree=1; fi
  done <<< "$items"
  if (( ${#labels[@]} == 0 )); then
    echo "Keine passenden macOS-Updates gefunden."
    return 0
  fi
  if [[ $agree == 1 ]]; then extra=(--agree-to-license); fi
  case $mode in
    download)
      run_with_timeout 14400 softwareupdate --download "${labels[@]}"
      ;;
    norestart)
      run_with_timeout 14400 softwareupdate --install "${labels[@]}" "${extra[@]}"
      ;;
    restart)
      if is_arm && [[ -s $CRED_FILE ]]; then
        run_with_timeout 14400 softwareupdate --install "${labels[@]}" "${extra[@]}" \
          --restart --user "$SUDO_USER" --stdinpass < "$CRED_FILE"
      else
        run_with_timeout 14400 softwareupdate --install "${labels[@]}" "${extra[@]}" --restart
      fi
      ;;
  esac
}
EOF_SHARED
eval "$SHARED_FUNCS"

# ══════════════════════════════════════════════════════════════════════════════
#  Root-Helper (Vorlage). Er wird bei --install nach $HELPER geschrieben,
#  gehört root und darf als Einziges per sudo ohne Passwort laufen.
# ══════════════════════════════════════════════════════════════════════════════
IFS= read -r -d '' HELPER_HEAD <<'EOF_HEAD'
#!/bin/bash
#
#  macupdate – Root-Helper
#  Wird vom nächtlichen Lauf über "sudo -n" gestartet (Regel: /etc/sudoers.d/macupdate).
#  Erzeugt von "macupdate --install" – bitte nicht von Hand bearbeiten.
#  Kennt nur fest eingebaute Aktionen und liest keine Dateien des Benutzers.
#
EOF_HEAD

IFS= read -r -d '' HELPER_CHECKS <<'EOF_CHECKS'
umask 022

die() { echo "macupdate-helper: $*" >&2; exit 2; }

[[ $EUID -eq 0 ]] || die "muss als root laufen"
case ${SUDO_USER:-} in
  ""|root) die "nur über sudo aus macupdate heraus aufrufen" ;;
  *[!A-Za-z0-9._-]*) die "ungültiger Benutzername" ;;
esac
EOF_CHECKS

IFS= read -r -d '' HELPER_BODY <<'EOF_BODY'
action=${1:-}
[[ $# -gt 0 ]] && shift
case $action in
  ping)
    echo ok
    ;;
  has-cred)
    [[ -s $CRED_FILE ]]
    ;;
  wake-set)
    case ${1:-} in
      [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) pmset repeat wake MTWRFSU "$1:00" ;;
      *) die "ungültige Uhrzeit" ;;
    esac
    ;;
  wake-cancel)
    pmset repeat cancel
    ;;
  mas-upgrade)
    [[ -x $MAS_BIN ]] || die "mas fehlt – bitte 'macupdate --install' ausführen"
    run_with_timeout 7200 "$MAS_BIN" update || run_with_timeout 7200 "$MAS_BIN" upgrade
    ;;
  macos-install)
    case ${1:-}/${2:-} in
      minor/norestart|minor/restart|minor/download|all/norestart|all/restart|all/download)
        macos_install "$1" "$2"
        ;;
      *) die "ungültige Parameter" ;;
    esac
    ;;
  *)
    die "unbekannte Aktion: $action"
    ;;
esac
EOF_BODY

build_helper() {
  local hp="/usr/bin:/bin:/usr/sbin:/sbin"
  # Nur in automatischen Tests (MACUPDATE_TEST_ROOT gesetzt) zeigt der PATH auf Attrappen.
  [[ -n $_R && -n ${MACUPDATE_TEST_PATH:-} ]] && hp="$MACUPDATE_TEST_PATH:$hp"
  printf '%s' "$HELPER_HEAD"
  printf 'PATH=%q\nexport PATH\n' "$hp"
  printf '%s\n' "$HELPER_CHECKS"
  printf 'MAS_BIN=%q\nCRED_FILE=%q\n\n' "$HELPER_MAS" "$HELPER_CRED"
  printf '%s\n' "$SHARED_FUNCS"
  printf '%s\n' "$HELPER_BODY"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Kleine Hilfsfunktionen
# ══════════════════════════════════════════════════════════════════════════════
log() {
  if [[ -n $LOG_FILE ]]; then
    printf '%s  %s\n' "$(date '+%H:%M:%S')" "$*"
  else
    printf '%s\n' "$*"
  fi
}
# Symbol vor die Meldung setzen, Einrückung der Meldung dabei behalten
_sym() {
  local sym=$1 msg=$2 ind=""
  while [[ $msg == " "* ]]; do ind="$ind "; msg=${msg# }; done
  log "$ind$sym $msg"
}
ok()      { _sym "✓" "$*"; }
info()    { _sym "→" "$*"; }
note()    { _sym "•" "$*"; }
warn()    { _sym "⚠" "$*"; WARNINGS=$((WARNINGS + 1)); }
err()     { _sym "✗" "$*"; ERRORS=$((ERRORS + 1)); }
section() { printf '\n━━ %s ━━\n' "$*"; }
die()     { printf 'Fehler: %s\n' "$*" >&2; exit 1; }
lower()   { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

join_by() {
  local sep=$1 out="" x
  shift
  for x in "$@"; do out="${out:+$out$sep}$x"; done
  printf '%s' "$out"
}

is_macos() { [[ $(uname -s) == Darwin || -n $_R ]]; }
is_admin() { id -Gn "$USER" 2>/dev/null | tr ' ' '\n' | grep -qx admin; }

find_brew() {
  local b
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x $b ]]; then printf '%s\n' "$b"; return 0; fi
  done
  command -v brew 2>/dev/null
}

# Symlinks auflösen (ohne realpath, das es erst ab macOS 13 gibt)
resolve_path() {
  local p=$1 t dir
  while [[ -L $p ]]; do
    t=$(readlink "$p")
    case $t in
      /*) p=$t ;;
      *) p="$(dirname "$p")/$t" ;;
    esac
  done
  if dir=$(cd "$(dirname "$p")" 2>/dev/null && pwd -P); then
    printf '%s/%s\n' "$dir" "$(basename "$p")"
  else
    printf '%s\n' "$p"
  fi
}
self_path() { resolve_path "${BASH_SOURCE[0]:-$0}"; }

sha256_of() { { shasum -a 256 "$1" 2>/dev/null || sha256sum "$1" 2>/dev/null; } | awk '{print $1}'; }

xml_escape() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

regex_escape() { printf '%s' "$1" | sed 's/[][\.*^$+?(){}|]/\\&/g'; }

# Ja/Nein-Frage im Terminal:  ask_yes_no "Frage" [j|n]  → Erfolg bei "ja"
ask_yes_no() {
  local def=${2:-n} hint ans=""
  if [[ $def == j ]]; then hint="[J/n]"; else hint="[j/N]"; fi
  printf '%s %s ' "$1" "$hint"
  if ! read -r ans 2>/dev/null </dev/tty; then ans=""; echo; fi
  ans=$(lower "$ans")
  [[ -z $ans ]] && ans=$def
  case $ans in
    j*|y*) return 0 ;;
  esac
  return 1
}

# Sekunden seit der letzten Maus-/Tastatureingabe
idle_seconds() {
  ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ {print int($NF/1000000000); exit}'
}
user_is_idle() {
  local s
  s=$(idle_seconds)
  is_uint "$s" && (( s >= IDLE_MINUTES * 60 ))
}

# Der Text wird als Argument (argv) übergeben und nicht in den AppleScript-Code
# eingesetzt – so können Anführungszeichen oder Backslashes nichts kaputt machen.
notify() {
  [[ $NOTIFY == yes ]] || return 0
  LC_ALL=en_US.UTF-8 osascript -e 'on run argv' \
    -e 'display notification (item 1 of argv) with title "macupdate"' \
    -e 'end run' "$1" >/dev/null 2>&1 || true
}

# Dialog auf dem Bildschirm. Erfolg = "Jetzt neu starten" gewählt.
# Ohne Antwort nach 3 Minuten gilt "Später".
ask_restart_dialog() {
  local out
  out=$(LC_ALL=en_US.UTF-8 run_with_timeout 200 osascript -e 'on run argv' \
    -e 'display dialog (item 1 of argv) with title "macupdate" buttons {"Später", "Jetzt neu starten"} default button "Später" with icon caution giving up after 180' \
    -e 'end run' "$1" 2>/dev/null)
  case $out in
    *"gave up:true"*) return 1 ;;
    *"Jetzt neu starten"*) return 0 ;;
  esac
  return 1
}

# ── Uhrzeiten ─────────────────────────────────────────────────────────────────
# "3", "3:00", "3.00", "03:00" → "03:00"
normalize_time() {
  local t=${1//./:} h m
  case $t in
    *:*) h=${t%%:*}; m=${t#*:} ;;
    *) h=$t; m=00 ;;
  esac
  is_uint "$h" && is_uint "$m" || return 1
  h=$((10#$h)); m=$((10#$m))
  (( h <= 23 && m <= 59 )) || return 1
  printf '%02d:%02d\n' "$h" "$m"
}
time_h() { printf '%d' "$((10#${1%%:*}))"; }
time_m() { printf '%d' "$((10#${1##*:}))"; }

# Weckzeit = eine Minute vor dem Lauf
wake_time_for() {
  local total
  total=$(( ( $(time_h "$1") * 60 + $(time_m "$1") - 1 + 1440 ) % 1440 ))
  printf '%02d:%02d' $((total / 60)) $((total % 60))
}

epoch_today_at() {
  date -j -v"$(time_h "$1")"H -v"$(time_m "$1")"M -v0S +%s 2>/dev/null \
    || date -d "today $1" +%s 2>/dev/null
}

next_run_epoch() {
  local now t
  now=$(date +%s)
  t=$(epoch_today_at "$UPDATE_TIME")
  if ! is_uint "$t"; then echo "$now"; return; fi
  (( t <= now )) && t=$((t + 86400))
  echo "$t"
}

# Unix-Zeit → "Sa 15.11. 03:00"
fmt_de() {
  local d wd
  local -a days
  days=(Mo Di Mi Do Fr Sa So)
  d=$(date -r "$1" '+%u %d.%m. %H:%M' 2>/dev/null || date -d "@$1" '+%u %d.%m. %H:%M' 2>/dev/null)
  wd=${d%% *}
  if ! is_uint "$wd"; then printf '%s' "$d"; return; fi
  printf '%s %s' "${days[wd-1]}" "${d#* }"
}

